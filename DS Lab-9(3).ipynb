      "cell_type": "code",
      "source": [
        "A = [64, 25, 12, 22, 11]\n",
        "\n",
        "for i in range(len(A)):\n",
        "\n",
        "    min_idx = i\n",
        "\n",
        "    for j in range(i + 1, len(A)):\n",
        "\n",
        "        if A[min_idx] > A[j]:\n",
        "\n",
        "            min_idx = j\n",
        "\n",
        "    A[i], A[min_idx] = A[min_idx], A[i]\n",
        "\n",
        "\n",
        "print(\"Sorted array\")\n",
        "\n",
        "for i in range(len(A)):\n",
        "\n",
        "    print(\"%d\" % A[i])"
      ],
